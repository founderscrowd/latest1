# Supabase Configuration (client-side, public)
# Only VITE_ prefixed vars are embedded in the browser bundle.
# NEVER put a service-role key here — it would be visible to anyone.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration (LIVE MODE)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
# Server-only secrets (used by Supabase Edge Functions, never exposed to the browser)
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# Live Stripe Price IDs
LIVE_MONTHLY_PRICE_ID=price_your_live_monthly_price_id
LIVE_ANNUAL_PRICE_ID=price_your_live_annual_price_id
